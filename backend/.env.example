SECRET_KEY=django-insecure-change-this-key-in-production
DEBUG=True

# Lokalda PostgreSQL o'rnatilmagan bo'lsa False qoldiring — SQLite avtomatik ishlatiladi
USE_POSTGRES=False
DB_NAME=savdo_market
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Render/production'da bu avtomatik beriladi, qo'lda kiritish shart emas
# DATABASE_URL=postgres://user:password@host:5432/dbname

ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
